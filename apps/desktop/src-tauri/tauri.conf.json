{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TouchGrassBar",
  "version": "0.0.0",
  "identifier": "app.touchgrass.bar",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'none'; connect-src ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "devCsp": "default-src 'self' http://127.0.0.1:1420; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline' http://127.0.0.1:1420; script-src 'self' 'unsafe-eval' http://127.0.0.1:1420"
    },
    "windows": [
      {
        "label": "panel",
        "title": "TouchGrassBar",
        "width": 402,
        "height": 640,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "settings",
        "title": "TouchGrassBar Settings",
        "width": 760,
        "height": 580,
        "dragDropEnabled": false,
        "resizable": false,
        "visible": false
      },
      {
        "label": "onboarding",
        "title": "Welcome to TouchGrassBar",
        "width": 760,
        "height": 580,
        "dragDropEnabled": false,
        "resizable": false,
        "visible": false
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdERTYwNDZBMzY1REVFQjcKUldTMzdsMDJhZ1RtZmRKOWw4b1htUzRLYnZYSXVHdzNGRStqWmlEay9IWkhHTWhnakQrbVFmdXAK",
      "endpoints": [
        "https://github.com/FabienGreard/TouchGrassBar/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "Copyright © 2026 TouchGrassBar contributors",
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "15.0"
    },
    "targets": ["app", "dmg"]
  }
}
