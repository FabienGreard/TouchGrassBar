{
  "name": "@touchgrass/desktop",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bunx --bun vite build",
    "bundle": "bun run --cwd ../.. desktop:bundle",
    "dev": "bun run --cwd ../.. dev:desktop",
    "dev:web": "bunx --bun vite",
    "lint": "bunx --bun oxlint -c ../../packages/tooling/oxlint.json src vite.config.ts",
    "tauri": "bunx --bun tauri",
    "test": "bun ../../scripts/run-vitest.ts",
    "typecheck": "bunx --bun tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "5.102.8",
    "@tauri-apps/api": "2.11.1",
    "@touchgrass/contracts": "workspace:*",
    "@touchgrass/ui": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/react": "^16",
    "@types/node": "26.1.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "happy-dom": "^20",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.0"
  }
}
