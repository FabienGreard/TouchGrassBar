---
import LandingExperience from "./LandingExperience";
import "../styles/global.css";
import { GARDEN_COPY, isGardenTime } from "../lib/garden-time";
import dawnGarden from "../styles/assets/dawn-garden.avif?url";
import dayGarden from "../styles/assets/day-garden.avif?url";
import goldenGarden from "../styles/assets/golden-garden.avif?url";
import nightGarden from "../styles/assets/night-garden.avif?url";

type Props = {
  invitation?: boolean;
};

const { invitation = false } = Astro.props;
const timeParam = Astro.url.searchParams.get("time");
const initialGardenTime = isGardenTime(timeParam) ? timeParam : undefined;
const title = invitation
  ? "Join a TouchGrassBar Doomerboard"
  : "TouchGrassBar — your token problem, in the menu bar";
const description = invitation
  ? "Install TouchGrassBar, create your Profile on your Mac, and join the Doomerboard."
  : "See Codex and Claude limits in the menu bar, then compare observed tokens on the Doomerboard.";
const gardenAssets = {
  dawn: dawnGarden,
  day: dayGarden,
  golden: goldenGarden,
  night: nightGarden,
};
---

<!doctype html>
<html class:list={{ "garden-time-pending": !initialGardenTime }} lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#070d0a" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <title>{title}</title>
    <noscript><style>html.garden-time-pending .d-garden-hero{visibility:visible}</style></noscript>
    <script is:inline define:vars={{ gardenAssets }}>
      (() => {
        const requestedGardenTime = new URLSearchParams(window.location.search).get("time");
        const explicitGardenTime = ["dawn", "day", "golden", "night"].includes(requestedGardenTime)
          ? requestedGardenTime
          : undefined;
        const hour = new Date().getHours();
        const localGardenTime = hour >= 5 && hour < 9
          ? "dawn"
          : hour >= 9 && hour < 17
            ? "day"
            : hour >= 17 && hour < 21
              ? "golden"
              : "night";
        const gardenTime = explicitGardenTime || localGardenTime;
        document.documentElement.dataset.gardenTime = gardenTime;
        const preload = document.createElement("link");
        preload.rel = "preload";
        preload.as = "image";
        preload.href = gardenAssets[gardenTime];
        preload.fetchPriority = "high";
        document.head.append(preload);
      })();
    </script>
  </head>
  <body data-page={invitation ? "invitation" : "landing"}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <LandingExperience initialGardenTime={initialGardenTime} invitation={invitation} />
    <script is:inline define:vars={{ gardenCopy: GARDEN_COPY, invitation }}>
      (() => {
        try {
          const gardenTime = document.documentElement.dataset.gardenTime;
          const hero = document.querySelector(".d-garden-hero");
          if (!hero || !gardenTime) return;

          hero.className = `d-garden-hero garden-${gardenTime} d-time-instant`;
          hero.querySelectorAll("[data-garden-layer]").forEach((layer) => {
            const layerTime = layer.dataset.gardenLayer;
            layer.className = `d-time-layer ${layerTime === gardenTime ? "active" : ""} time-${layerTime}`;
          });

          if (!invitation) {
            hero.querySelectorAll("[data-garden-copy-line]").forEach((line) => {
              const index = Number(line.dataset.gardenCopyLine);
              const nextCopy = gardenCopy[gardenTime][index];
              if (line.textContent !== nextCopy) line.textContent = nextCopy;
            });
          }
        } finally {
          document.documentElement.classList.remove("garden-time-pending");
        }
      })();
    </script>
    <script>
      import { installAnalytics } from "../lib/analytics";
      import { installDownloadResolver } from "../lib/download-resolver";
      import { GARDEN_COPY, gardenTimeForHour, isGardenTime } from "../lib/garden-time";

      installAnalytics();

      const updateGarden = () => {
        const requestedGardenTime = new URLSearchParams(window.location.search).get("time");
        const gardenTime = isGardenTime(requestedGardenTime)
          ? requestedGardenTime
          : gardenTimeForHour(new Date().getHours());
        const hero = document.querySelector<HTMLElement>(".d-garden-hero");

        document.documentElement.dataset.gardenTime = gardenTime;
        if (!hero) return;

        hero.className = `d-garden-hero garden-${gardenTime}`;
        for (const layer of hero.querySelectorAll<HTMLElement>("[data-garden-layer]")) {
          const layerTime = layer.dataset.gardenLayer;
          layer.className = `d-time-layer ${layerTime === gardenTime ? "active" : ""} time-${layerTime}`;
        }

        if (document.body.dataset.page !== "invitation") {
          for (const line of hero.querySelectorAll<HTMLElement>("[data-garden-copy-line]")) {
            const index = Number(line.dataset.gardenCopyLine);
            const nextCopy = GARDEN_COPY[gardenTime][index];
            if (nextCopy && line.textContent !== nextCopy) line.textContent = nextCopy;
          }
        }
      };

      const menubar = document.querySelector<HTMLElement>(".d-menubar");
      const updateHeader = () => menubar?.classList.toggle("scrolled", window.scrollY > 24);
      updateHeader();
      window.addEventListener("scroll", updateHeader, { passive: true });

      const specimenObservers: ResizeObserver[] = [];
      for (const frame of document.querySelectorAll<HTMLElement>(".product-specimen-frame")) {
        const canvas = frame.querySelector<HTMLElement>(".product-specimen-canvas");
        if (!canvas) continue;

        let animationFrame = 0;
        let previousCanvasHeight = -1;
        let previousFrameWidth = -1;
        const updateScale = () => {
          window.cancelAnimationFrame(animationFrame);
          animationFrame = window.requestAnimationFrame(() => {
            const canvasHeight = canvas.offsetHeight;
            const frameWidth = frame.clientWidth;
            if (canvasHeight === previousCanvasHeight && frameWidth === previousFrameWidth) return;

            previousCanvasHeight = canvasHeight;
            previousFrameWidth = frameWidth;
            const designWidth = Number.parseFloat(
              window.getComputedStyle(frame).getPropertyValue("--product-specimen-width"),
            );
            const scale = Number.isFinite(designWidth) && designWidth > 0
              ? Math.min(1, frameWidth / designWidth)
              : 1;
            frame.style.setProperty("--product-specimen-scale", String(scale));
            frame.style.height = `${canvasHeight * scale}px`;
          });
        };

        const observer = new ResizeObserver(updateScale);
        observer.observe(canvas);
        observer.observe(frame);
        specimenObservers.push(observer);
        updateScale();
      }

      window.setInterval(updateGarden, 60_000);
      window.addEventListener("popstate", updateGarden);
      const resolveDownload = () => void installDownloadResolver(document, window.fetch.bind(window));
      if (window.requestIdleCallback) {
        window.requestIdleCallback(resolveDownload, { timeout: 2_000 });
      } else {
        window.setTimeout(resolveDownload, 1_000);
      }
    </script>
  </body>
</html>
