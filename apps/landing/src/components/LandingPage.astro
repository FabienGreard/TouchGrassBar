---
import LandingExperience from "./LandingExperience";
import "../styles/global.css";
import { GARDEN_COPY, isGardenTime } from "../lib/garden-time";
import dawnGarden from "../styles/assets/dawn-garden.avif?url";
import dayGarden from "../styles/assets/day-garden.avif?url";
import goldenGarden from "../styles/assets/golden-garden.avif?url";
import nightGarden from "../styles/assets/night-garden.avif?url";

const timeParam = Astro.url.searchParams.get("time");
const initialGardenTime = isGardenTime(timeParam) ? timeParam : undefined;
const title = "TouchGrassBar — Codex & Claude Usage in Your Menu Bar";
const description = "See your Codex and Claude usage limits in your Mac menu bar. Compare your usage on the leaderboard while prompts and provider data stay on your Mac.";
const siteUrl = Astro.site ?? new URL("https://touchgrassbar.com");
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const socialImageUrl = new URL("/og.jpg", siteUrl);
const socialImageAlt = "Humanity built intelligence. Then added a usage limit. Download TouchGrassBar for macOS and install it in the Applications folder.";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  applicationCategory: "DeveloperApplication",
  description,
  downloadUrl: "https://github.com/FabienGreard/TouchGrassBar/releases/latest",
  image: socialImageUrl.toString(),
  isAccessibleForFree: true,
  name: "TouchGrassBar",
  operatingSystem: "macOS",
  sameAs: ["https://github.com/FabienGreard/TouchGrassBar"],
  url: canonicalUrl.toString(),
};
const gardenAssets = {
  dawn: dawnGarden,
  day: dayGarden,
  golden: goldenGarden,
  night: nightGarden,
};
---

<!doctype html>
<html class:list={{ "garden-time-pending": !initialGardenTime }} lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#070d0a" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TouchGrassBar" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@FabienGreard" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script is:inline define:vars={{ gardenAssets }}>
      (() => {
        const requestedGardenTime = new URLSearchParams(window.location.search).get("time");
        const explicitGardenTime = ["dawn", "day", "golden", "night"].includes(requestedGardenTime)
          ? requestedGardenTime
          : undefined;
        const hour = new Date().getHours();
        const localGardenTime = hour >= 5 && hour < 9
          ? "dawn"
          : hour >= 9 && hour < 17
            ? "day"
            : hour >= 17 && hour < 21
              ? "golden"
              : "night";
        const gardenTime = explicitGardenTime || localGardenTime;
        document.documentElement.dataset.gardenTime = gardenTime;
        const preload = document.createElement("link");
        preload.rel = "preload";
        preload.as = "image";
        preload.href = gardenAssets[gardenTime];
        preload.fetchPriority = "high";
        document.head.append(preload);
      })();
    </script>
  </head>
  <body data-page="landing">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <LandingExperience initialGardenTime={initialGardenTime} />
    <script is:inline define:vars={{ gardenCopy: GARDEN_COPY }}>
      (() => {
        try {
          const gardenTime = document.documentElement.dataset.gardenTime;
          const hero = document.querySelector(".d-garden-hero");
          if (!hero || !gardenTime) return;

          hero.className = `d-garden-hero garden-${gardenTime} d-time-instant`;
          hero.querySelectorAll("[data-garden-layer]").forEach((layer) => {
            const layerTime = layer.dataset.gardenLayer;
            layer.className = `d-time-layer ${layerTime === gardenTime ? "active" : ""} time-${layerTime}`;
          });

          hero.querySelectorAll("[data-garden-copy-line]").forEach((line) => {
            const index = Number(line.dataset.gardenCopyLine);
            const nextCopy = gardenCopy[gardenTime][index];
            if (line.textContent !== nextCopy) line.textContent = nextCopy;
          });
        } finally {
          document.documentElement.classList.remove("garden-time-pending");
        }
      })();
    </script>
    <script>
      import { installAnalytics } from "../lib/analytics";
      import { installDownloadResolver } from "../lib/download-resolver";
      import { GARDEN_COPY, gardenTimeForHour, isGardenTime } from "../lib/garden-time";
      import { installInviteParallax } from "../lib/invite-parallax";
      import { installWebMcp } from "../lib/webmcp";

      installAnalytics();
      installInviteParallax(document, window);
      void installWebMcp(document);

      const updateGarden = () => {
        const requestedGardenTime = new URLSearchParams(window.location.search).get("time");
        const gardenTime = isGardenTime(requestedGardenTime)
          ? requestedGardenTime
          : gardenTimeForHour(new Date().getHours());
        const hero = document.querySelector<HTMLElement>(".d-garden-hero");

        document.documentElement.dataset.gardenTime = gardenTime;
        if (!hero) return;

        hero.className = `d-garden-hero garden-${gardenTime}`;
        for (const layer of hero.querySelectorAll<HTMLElement>("[data-garden-layer]")) {
          const layerTime = layer.dataset.gardenLayer;
          layer.className = `d-time-layer ${layerTime === gardenTime ? "active" : ""} time-${layerTime}`;
        }

        for (const line of hero.querySelectorAll<HTMLElement>("[data-garden-copy-line]")) {
          const index = Number(line.dataset.gardenCopyLine);
          const nextCopy = GARDEN_COPY[gardenTime][index];
          if (nextCopy && line.textContent !== nextCopy) line.textContent = nextCopy;
        }
      };

      const menubar = document.querySelector<HTMLElement>(".d-menubar");
      const updateHeader = () => menubar?.classList.toggle("scrolled", window.scrollY > 24);
      updateHeader();
      window.addEventListener("scroll", updateHeader, { passive: true });

      for (const frame of document.querySelectorAll<HTMLElement>(".product-specimen-frame")) {
        const canvas = frame.querySelector<HTMLElement>(".product-specimen-canvas");
        if (!canvas) continue;

        let animationFrame = 0;
        let previousAvailableHeight = -1;
        let previousCanvasHeight = -1;
        let previousFrameWidth = -1;
        let previousMaxScale = -1;
        const updateScale = () => {
          window.cancelAnimationFrame(animationFrame);
          animationFrame = window.requestAnimationFrame(() => {
            const canvasHeight = canvas.offsetHeight;
            const frameWidth = frame.clientWidth;
            const availableHeight = window.matchMedia("(min-width: 901px)").matches
              ? Math.max(0, window.innerHeight - 96)
              : Number.POSITIVE_INFINITY;
            const computedMaxScale = Number.parseFloat(
              window.getComputedStyle(frame).getPropertyValue("--product-specimen-max-scale"),
            );
            const maxScale = Number.isFinite(computedMaxScale) && computedMaxScale > 0
              ? computedMaxScale
              : 1;
            if (
              availableHeight === previousAvailableHeight &&
              canvasHeight === previousCanvasHeight &&
              frameWidth === previousFrameWidth &&
              maxScale === previousMaxScale
            ) return;

            previousAvailableHeight = availableHeight;
            previousCanvasHeight = canvasHeight;
            previousFrameWidth = frameWidth;
            previousMaxScale = maxScale;
            const designWidth = Number.parseFloat(
              window.getComputedStyle(frame).getPropertyValue("--product-specimen-width"),
            );
            const scale = Number.isFinite(designWidth) && designWidth > 0
              ? Math.min(maxScale, frameWidth / designWidth, availableHeight / canvasHeight)
              : 1;
            frame.style.setProperty("--product-specimen-scale", String(scale));
            frame.style.height = `${canvasHeight * scale}px`;
          });
        };

        const observer = new ResizeObserver(updateScale);
        observer.observe(canvas);
        observer.observe(frame);
        window.addEventListener("resize", updateScale, { passive: true });
        updateScale();
      }

      window.setInterval(updateGarden, 60_000);
      window.addEventListener("popstate", updateGarden);
      const resolveDownload = () => void installDownloadResolver(document, window.fetch.bind(window));
      if (window.requestIdleCallback) {
        window.requestIdleCallback(resolveDownload, { timeout: 2_000 });
      } else {
        window.setTimeout(resolveDownload, 1_000);
      }
    </script>
  </body>
</html>
