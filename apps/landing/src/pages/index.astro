---
import "../styles/global.css";

const features = [
  ["Know the ceiling", "Codex and Claude limits, remaining usage, and provider reset times—without inventing a fake combined quota."],
  ["Count the damage", "Observed tokens for today, 7 days, and 30 days, plus clearly labeled API-equivalent pricing."],
  ["Find your people", "Global and My Tokenmaxxers Doomerboards for Codex, Claude, or the combined Token Score."],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="TouchGrassBar makes Codex and Claude usage glanceable and unnecessarily competitive." />
    <meta name="viewport" content="width=device-width" />
    <title>TouchGrassBar — the Doomerboard for tokenmaxxers</title>
  </head>
  <body class="min-h-screen text-ash-100">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-6">
      <a href="/" class="text-sm font-semibold tracking-tight">TouchGrassBar</a>
      <a href="https://github.com/FabienGreard/TouchGrassBar" class="text-sm text-ash-400 transition hover:text-ash-100">GitHub</a>
    </nav>

    <main>
      <section class="mx-auto grid max-w-6xl gap-14 px-6 pb-24 pt-20 lg:grid-cols-[1.15fr_0.85fr] lg:items-center">
        <div>
          <p class="mb-5 font-mono text-xs uppercase tracking-[0.2em] text-grass-300">Depression 1o1, now measurable</p>
          <h1 class="m-0 max-w-3xl text-5xl font-semibold leading-[0.96] tracking-[-0.055em] sm:text-7xl">
            Touch grass.<br />After this run.
          </h1>
          <p class="mt-7 max-w-xl text-lg leading-8 text-ash-400">
            Your Codex and Claude limits in the menu bar. Your observed token burn on a public Doomerboard. No prompts, raw logs, credentials, or local paths ever leave your Mac.
          </p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href="#download" class="rounded-full bg-grass-400 px-5 py-3 text-sm font-semibold text-grass-950 transition hover:bg-grass-300">Download for macOS</a>
            <a href="#privacy" class="rounded-full border border-ash-700 px-5 py-3 text-sm font-semibold transition hover:border-ash-400">See the boundary</a>
          </div>
        </div>

        <div class="mx-auto w-full max-w-sm rounded-[1.6rem] border border-ash-700 bg-ash-950 p-3 shadow-2xl shadow-grass-950/50">
          <div class="rounded-2xl bg-ash-900 p-4">
            <div class="flex items-start justify-between">
              <div>
                <p class="m-0 text-xs uppercase tracking-[0.14em] text-ash-400">Combined · Today</p>
                <p class="mb-0 mt-1 text-3xl font-semibold tabular-nums">12.8M</p>
              </div>
              <span class="rounded-full bg-grass-400 px-2 py-1 text-[11px] font-semibold text-grass-950">still online</span>
            </div>
            <p class="mb-5 mt-1 text-xs text-ash-400">≈ $38.61 API equivalent</p>
            <div class="space-y-2 font-mono text-sm">
              <div class="flex justify-between rounded-lg bg-ash-950 px-3 py-2"><span>1. laura #TG-4COLD7</span><span>18.2M</span></div>
              <div class="flex justify-between rounded-lg border border-grass-400 px-3 py-2 text-grass-300"><span>2. you #TG-7K4P9D</span><span>12.8M</span></div>
              <div class="flex justify-between rounded-lg bg-ash-950 px-3 py-2"><span>3. max #TG-BURN42</span><span>9.1M</span></div>
            </div>
          </div>
        </div>
      </section>

      <section class="border-y border-ash-700 bg-ash-900/50">
        <div class="mx-auto grid max-w-6xl gap-4 px-6 py-16 md:grid-cols-3">
          {features.map(([title, copy]) => (
            <article class="rounded-2xl border border-ash-700 bg-ash-950 p-6">
              <h2 class="m-0 text-lg font-semibold">{title}</h2>
              <p class="mb-0 mt-3 leading-7 text-ash-400">{copy}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="privacy" class="mx-auto max-w-4xl px-6 py-24 text-center">
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-grass-300">Public score, private work</p>
        <h2 class="mt-4 text-4xl font-semibold tracking-tight">Only daily usage aggregates leave the Mac.</h2>
        <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-ash-400">Never prompts, conversations, credentials, cookies, raw logs, or local file paths. Public by design means your Token Score is visible—not your work.</p>
      </section>

      <section id="download" class="mx-auto max-w-6xl px-6 pb-24">
        <div class="rounded-3xl bg-grass-400 px-7 py-14 text-center text-grass-950">
          <h2 class="m-0 text-4xl font-semibold tracking-tight">One more agent won’t hurt.</h2>
          <p class="mx-auto mt-4 max-w-lg">macOS menu bar only. Codex and Claude only. Open source forever.</p>
          <a href="https://github.com/FabienGreard/TouchGrassBar/releases" class="mt-7 inline-flex rounded-full bg-grass-950 px-5 py-3 text-sm font-semibold text-grass-50">Releases coming after the native gates</a>
        </div>
      </section>
    </main>
  </body>
</html>
