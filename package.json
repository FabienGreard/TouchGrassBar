{
  "name": "touchgrassbar",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bunx --bun turbo run build",
    "dev": "bunx --bun turbo run dev",
    "doctor": "bunx --bun react-doctor@0.9.3 --yes --blocking warning --no-score",
    "doctor:score": "bunx --bun react-doctor@0.9.3 --yes --json --json-compact",
    "lint": "bunx --bun turbo run lint",
    "test": "bunx --bun turbo run test",
    "test:visual": "bun run --cwd apps/desktop test:visual",
    "typecheck": "bunx --bun turbo run typecheck",
    "quality": "bun run contracts:check && bun run lint && bun run typecheck && bun run test && bun run build && bun run doctor",
    "convex:dev": "bunx --bun convex dev",
    "convex:codegen": "bunx --bun convex codegen",
    "convex:ai:status": "bunx --bun convex ai-files status",
    "contracts:generate": "bun scripts/generate-native-contract.ts",
    "contracts:check": "bun scripts/generate-native-contract.ts --check",
    "desktop": "bun run --cwd apps/desktop tauri dev",
    "landing": "bun run --cwd apps/landing dev",
    "storybook:ui": "bun run --cwd packages/ui storybook",
    "storybook:ui:build": "bun run --cwd packages/ui build-storybook"
  },
  "devDependencies": {
    "oxlint": "1.76.0",
    "react-doctor": "0.9.3",
    "turbo": "2.10.8",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
