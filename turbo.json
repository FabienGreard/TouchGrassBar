{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "passThroughEnv": [
        "CONVEX_SITE_URL",
        "CONVEX_URL",
        "TOUCHGRASS_DEV_PROVISIONING_PROFILE",
        "TOUCHGRASS_DEV_SIGNING_IDENTITY"
      ],
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
