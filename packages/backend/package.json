{
  "name": "@touchgrass/backend",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bun run typecheck",
    "convex": "bun ../../scripts/run-convex.ts",
    "dev": "bun run --cwd ../.. dev:backend",
    "dashboard": "bun run --cwd ../.. backend:dashboard",
    "codegen": "bun run --cwd ../.. convex:codegen",
    "lint": "bunx --bun oxlint -c ../tooling/oxlint.json convex",
    "test": "bun ../../scripts/run-vitest.ts",
    "typecheck": "bunx --bun tsc --noEmit"
  },
  "dependencies": {
    "@convex-dev/aggregate": "0.2.2",
    "@convex-dev/better-auth": "0.12.5",
    "@convex-dev/migrations": "0.3.6",
    "@convex-dev/rate-limiter": "0.3.2",
    "@touchgrass/contracts": "workspace:*",
    "better-auth": "1.6.25",
    "convex": "1.43.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "convex-test": "0.0.51",
    "typescript": "7.0.2",
    "vite": "8.2.0"
  }
}
