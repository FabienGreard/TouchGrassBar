{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TouchGrassBar Viability",
  "version": "0.0.0",
  "identifier": "com.touchgrassbar.viability",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "panel",
        "title": "TouchGrassBar",
        "visible": false,
        "width": 360,
        "height": 520,
        "center": false,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "focus": false,
        "shadow": true
      },
      {
        "label": "settings",
        "title": "TouchGrassBar Settings",
        "visible": false,
        "width": 560,
        "height": 420,
        "center": true,
        "decorations": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    }
  }
}
